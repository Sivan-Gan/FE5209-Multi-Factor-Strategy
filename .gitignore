# Operating-system and editor metadata
.DS_Store
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.venv/
.ipynb_checkpoints/
.vscode/
.idea/
*.swp
*.swo
*.tmp
*.temp
.coverage
.mypy_cache/
build/
dist/
*.egg-info/
*.log

# Local secrets and machine authentication; example configuration remains trackable.
.env
.env.*
!.env.example
.pgpass
.aws/
wrds_credentials*
credentials*.json
secrets*.yaml
secrets*.yml
/config/paths.yaml

# Local agent/session working ledgers; not research deliverables
.planning/

# Old Yahoo + SEC raw source package (kept locally, never versioned)
/raw_package/

# New formal WRDS raw source package (kept locally, never versioned)
/wrds_raw/

# Large generated/intermediate DEV data panels; small canonical metadata CSVs remain trackable
/data/canonical/*.sqlite
/data/canonical/*.sqlite-wal
/data/canonical/*.sqlite-shm
/data/canonical/*.csv.gz
/data/canonical/wrds_formal/*.sqlite
/data/canonical/wrds_formal/*.sqlite-wal
/data/canonical/wrds_formal/*.sqlite-shm
/data/canonical/wrds_formal/extensions/*.sqlite
/data/canonical/wrds_formal/extensions/*.sqlite-wal
/data/canonical/wrds_formal/extensions/*.sqlite-shm
/data/factors/us_formal/*.sqlite
/data/factors/us_formal/*.sqlite-wal
/data/factors/us_formal/*.sqlite-shm
/data/validation/us_formal/*.sqlite
/data/validation/us_formal/*.sqlite-wal
/data/validation/us_formal/*.sqlite-shm
/data/interim/*
!/data/interim/README.md
/data/dev_legacy/canonical/*.sqlite
/data/dev_legacy/canonical/*.sqlite-wal
/data/dev_legacy/canonical/*.sqlite-shm
/data/dev_legacy/canonical/*.csv.gz
/data/dev_legacy/interim/

# Large compressed factor outputs; audit summaries and small reports remain trackable
/outputs/factor_research/**/*.csv.gz

# Protect any future/unapproved final-factor Parquet. The explicitly approved
# delivery files are force-staged under exact Git-LFS rules in .gitattributes.
/handoff/final_factor/data/*.parquet

# Protect any future/unapproved all-specification archive Parquet. Approved
# delivery artifacts are force-staged under exact Git-LFS rules.
/handoff/factor_research_archive/data/*.parquet

# Protect any future/unapproved downstream Parquet. Contracts, manifests, QA,
# deterministic samples, and explicitly approved Git-LFS artifacts are governed
# separately; this rule remains the default guardrail.
/handoff/us_downstream/data/*.parquet
